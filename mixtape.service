# systemd unit for the mixtape *daemon* (the long-running service that
# owns sync, USB watcher, bgutil supervisor, and exposes a local HTTP +
# WebSocket API for the TUI / desktop UI to talk to).
#
# install.sh --systemd installs this for you. To do it manually:
#   $ cp mixtape.service ~/.config/systemd/user/
#   $ systemctl --user daemon-reload
#   $ systemctl --user enable --now mixtape.service
#
# Logs:
#   $ journalctl --user -u mixtape.service -f
#
# WorkingDirectory is rewritten by install.sh to the actual install
# path. Environment lines ensure deno + uv are on PATH for the
# non-interactive systemd shell.

[Unit]
Description=mixtape daemon — sync engine + USB watcher + local API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/mixtape-app
Environment="PATH=%h/.deno/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env uv run mixtape-daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
